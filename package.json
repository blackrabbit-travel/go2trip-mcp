{
  "name": "go2trip-mcp",
  "version": "1.0.0",
  "description": "Local (stdio) MCP server for Go2Trip, your travel solution in chat. Forwards to the hosted Go2Trip server at mcp.go2trip.com; no sign-in, no API key.",
  "type": "module",
  "bin": {
    "go2trip-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "travel",
    "go2trip"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackrabbit-travel/go2trip-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.0"
  }
}
